{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banks-mfs-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banks-db",
      "database_id": "63db858a-1756-4416-87f9-03d25c3c8fdb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bank-mfs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
