{
  "name": "banks-mfs-api",
  "version": "1.0.0",
  "description": "Blazing fast API and Edge CDN for Bangladesh Banks and Mobile Financial Services (MFS) logos and details",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute banks-mfs --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute banks-mfs --local --file=./migrations/0001_init.sql",
    "assets:optimize": "python3 scripts/optimize_assets.py",
    "assets:upload": "bash scripts/upload_to_r2.sh",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "banks",
    "mfs",
    "bangladesh",
    "logos",
    "swift-code",
    "routing-number",
    "cloudflare-workers",
    "d1",
    "r2"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.83.0"
  }
}
